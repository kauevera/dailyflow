<div class="auth-container">
  <div class="auth-header">
    <h1>Nova Tarefa</h1>
    <p>O que precisa ser feito hoje?</p>
  </div>

  <%= form_with model: @task, local: true do |f| %>
    <div class="form-group">
      <%= f.label :titulo, "Título" %>
      <%= f.text_field :titulo, placeholder: "Ex: Estudar Ruby", required: true %>
    </div>

    <div class="form-group">
      <%= f.label :descricao, "Descrição" %>
      <%= f.text_area :descricao, placeholder: "Detalhes da tarefa...", rows: 3 %>
    </div>

    <div class="form-group">
      <%= f.label :category_id, "Categoria" %>
      <%= f.collection_select :category_id, @categories, :id, :nome, { prompt: "Selecione uma categoria" } %>
    </div>

    <div class="form-group">
      <%= f.label :prioridade, "Prioridade" %>
      <%= f.select :prioridade, [["Baixa", 1], ["Média", 2], ["Alta", 3]] %>
    </div>

    <div class="form-group">
      <%= f.label :data_vencimento, "Data de Vencimento" %>
      <%= f.date_field :data_vencimento %>
    </div>

    <%= f.submit "Salvar Tarefa", class: "btn-auth" %>
    <div style="text-align: center; margin-top: 1rem;">
      <%= link_to "Cancelar", tasks_path, style: "color: var(--text-muted); text-decoration: none; font-size: 0.875rem;" %>
    </div>
  <% end %>
</div>
